{"type":"message","id":"a3c1420c","parentId":"1573b76e","timestamp":"2026-06-10T00:07:57.426Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_ibq8ls45","name":"write","arguments":{"content":"\"use client\";\nimport React, { useState } from 'react';\nimport { mockDb } from '@/lib/store/mockDb';\nimport { User, PatientData } from '@/types';\nimport { User as UserIcon, FileText, Upload, CheckCircle, AlertCircle } from 'lucide-react';\n\nexport default function UserProfile() {\n  const [user, setUser] = useState<User>(mockDb.getUsers()[1]); // Simulado Juan Pérez\n  const [formData, setFormData] = useState<PatientData>(user.personalData || {\n    bloodType: '',\n    birthDate: '',\n    gender: '',\n    address: '',\n    emergencyContact: '',\n    allergies: [],\n    chronicDiseases: [],\n    idCardNumber: '',\n    idCardVerified: false,\n  });\n  const [isUploading, setIsUploading] = useState(false);\n  const [uploadStatus, setUploadStatus] = useState<'idle' | 'processing' | 'success'>('idle');\n\n  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement>) => {\n    setFormData({ ...formData, [e.target.name]: e.target.value });\n  };\n\n  const simulateAIOCR = () => {\n    setIsUploading(true);\n    setUploadStatus('processing');\n    \n    // Simulando el procesamiento de la IA OCR\n    setTimeout(() => {\n      setFormData({\n        ...formData,\n        idCardNumber: '1712345678', // Dato extraído por IA\n        birthDate: '1990-05-15',     // Dato extraído por IA\n      });\n      setUploadStatus('success');\n      setIsUploading(false);\n    }, 3000);\n  };\n\n  return (\n    <div className=\"p-6 max-w-4xl mx-auto bg-gray-50 min-h-screen font-sans\">\n      <div className=\"mb-8 flex items-center justify-between\">\n        <div>\n          <h1 className=\"text-3xl font-bold text-blue-900\">Mi Perfil de Salud</h1>\n          <p className=\"text-gray-500\">Completa tu información para una mejor atención</p>\n        </div>\n        <div className={`flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold ${\n          user.profileStatus === 'verified' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'\n        }`}>\n          {user.profileStatus === 'verified' ? <CheckCircle size={16}/> : <AlertCircle size={16}/>}\n          {user.profileStatus.replace('_', ' ').toUpperCase()}\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {/* Sidebar de Estado */}\n        <div className=\"bg-white p-6 rounded-2xl shadow-sm border border-gray-100 h-fit\">\n          <div className=\"flex flex-col items-center text-center\">\n            <div className=\"w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 mb-4\">\n              <UserIcon size={40} />\n            </div>\n            <h2 className=\"font-bold text-lg\">{user.name}</h2>\n            <p className=\"text-sm text-gray-500 mb-6\">{user.email}</p>\n            \n            <div className=\"w-full space-y-3\">\n              <div className=\"flex justify-between text-xs p-2 bg-gray-50 rounded-lg\">\n                <span>Datos Personales</span>\n                <span className={formData.idCardNumber ? 'text-green-500 font-bold' : 'text-gray-400'}>\n                  {formData.idCardNumber ? '✓' : '✕'}\n                </span>\n              </div>\n              <div className=\"flex justify-between text-xs p-2 bg-gray-50 rounded-lg\">\n                <span>Cédula Verificada</span>\n                <span className={formData.idCardVerified ? 'text-green-500 font-bold' : 'text-gray-400'}>\n                  {formData.idCardVerified ? '✓' : '✕'}\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Formulario de Datos */}\n        <div className=\"md:col-span-2 bg-white p-8 rounded-2xl shadow-sm border border-gray-100\">\n          <div className=\"flex items-center gap-3 mb-6 text-blue-600\">\n            <FileText size={20} />\n            <h2 className=\"font-semibold text-xl\">Información Médica</h2>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-gray-400 uppercase\">Cédula de Identidad</label>\n              <div className=\"flex gap-2\">\n                <input \n                  name=\"idCardNumber\"\n                  value={formData.idCardNumber}\n                  onChange={handleInputChange}\n                  className=\"flex-1 p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\" \n                  placeholder=\"Ej: 1712345678\"\n                />\n                <button \n                  onClick={simulateAIOCR}\n                  disabled={isUploading}\n                  className=\"p-3 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-all disabled:bg-gray-300\"\n                  title=\"Escanear con IA\"\n                >\n                  {isUploading ? <div className=\"animate-spin border-2 border-white border-t-transparent rounded-full w-5 h-5\" /> : <Upload size={20} />}\n                </button>\n              </div>\n              {uploadStatus === 'success' && <p className=\"text-xs text-green-600 font-medium\">✓ Datos extraídos automáticamente por IA</p>}\n            </div>\n\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-gray-400 uppercase\">Tipo de Sangre</label>\n              <select \n                name=\"bloodType\"\n                value={formData.bloodType}\n                onChange={handleInputChange}\n                className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\"\n              >\n                <option value=\"\">Seleccione...</option>\n                <option value=\"A+\">A+</option>\n                <option value=\"A-\">A-</option>\n                <option value=\"B+\">B+</option>\n                <option value=\"B-\">B-</option>\n                <option value=\"O+\">O+</option>\n                <option value=\"O-\">O-</option>\n                <option value=\"AB+\">AB+</option>\n                <option value=\"AB-\">AB-</option>\n              </select>\n            </div>\n\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-gray-400 uppercase\">Fecha de Nacimiento</label>\n              <input \n                type=\"date\"\n                name=\"birthDate\"\n                value={formData.birthDate}\n                onChange={handleInputChange}\n                className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\" \n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-gray-400 uppercase\">Género</label>\n              <select \n                name=\"gender\"\n                value={formData.gender}\n                onChange={handleInputChange}\n                className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\"\n              >\n                <option value=\"\">Seleccione...</option>\n                <option value=\"Masculino\">Masculino</option>\n                <option value=\"Femenino\">Femenino</option>\n                <option value=\"Otro\">Otro</option>\n              </select>\n            </div>\n\n            <div className=\"md:col-span-2 space-y-2\">\n              <label className=\"text-xs font-bold text-gray-400 uppercase\">Alergias / Enfermedades Crónicas</label>\n              <textarea \n                placeholder=\"Ej: Alérgico a la Penicilina, Diabetes Tipo 2...\" \n                className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\" \n                rows={3}\n                value={formData.allergies.join(', ')}\n                onChange={(e) => setFormData({...formData, allergies: e.target.value.split(',')})}\n              />\n            </div>\n          </div>\n\n          <button \n            className=\"mt-8 w-full bg-blue-600 text-white py-4 rounded-2xl font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-200\"\n            onClick={() => alert('Datos guardados. Esperando validación física en recepción.')}\n          >\n            Guardar y Enviar Ficha\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n","path":"/Users/macbook2019/web_doctora_final/website/src/app/user/profile/page.tsx"}}],"stopReason":"toolUse","api":"ollama","provider":"ollama","model":"gemma4:31b-cloud","usage":{"input":58168,"output":2287,"cacheRead":0,"cacheWrite":0,"totalTokens":60455,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"timestamp":1781050077423}}
