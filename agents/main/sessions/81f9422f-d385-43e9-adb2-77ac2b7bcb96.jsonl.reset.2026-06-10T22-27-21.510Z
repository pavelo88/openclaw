ty: 'General', bio: 'Medicina general preventiva.', consultationFee: 30,\n      availability: { days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], startTime: '09:00', endTime: '17:00' }\n    },\n    {\n      id: 'd4', email: 'gen2@clinica.com', name: 'Dr. Roberto Cura', role: 'DOCTOR',\n      profileStatus: 'verified',\n      specialty: 'General', bio: 'Medicina interna.', consultationFee: 30,\n      availability: { days: ['Monday', 'Wednesday', 'Friday'], startTime: '13:00', endTime: '21:00' }\n    },\n  ],\n  appointments: [\n    { id: 'a1', patientId: 'u2', doctorId: 'd1', date: '2026-06-15', time: '10:00', status: 'scheduled', paymentStatus: 'paid' },\n    { id: 'a2', patientId: 'u3', doctorId: 'd3', date: '2026-06-12', time: '16:30', status: 'completed', paymentStatus: 'paid' },\n  ],\n  evolutions: [\n    { \n      id: 'e1', appointmentId: 'a2', patientId: 'u3', doctorId: 'd3', \n      date: '2026-06-12', symptoms: 'Fiebre y dolor de garganta', \n      diagnosis: 'Faringitis bacteriana', treatment: 'Reposo y antibióticos' \n    }\n  ],\n  prescriptions: [\n    {\n      id: 'p1', appointmentId: 'a2', patientId: 'u3', doctorId: 'd3',\n      medications: [{ name: 'Amoxicilina', dosage: '500mg', frequency: 'cada 8 horas', startTime: '08:00', duration: '7 días' }],\n      createdAt: '2026-06-12'\n    }\n  ],\n  payments: [\n    { id: 'pay1', appointmentId: 'a1', amount: 45, status: 'completed', method: 'card', createdAt: '2026-06-10' },\n    { id: 'pay2', appointmentId: 'a2', amount: 30, status: 'completed', method: 'transfer', createdAt: '2026-06-12' },\n  ]\n};\n\nexport const mockDb = {\n  getUsers: () => db.users as User[],\n  getDoctors: () => db.doctors as Doctor[],\n  getAppointments: () => db.appointments as Appointment[],\n  getEvolutions: () => db.evolutions as EvolutionNote[],\n  getPrescriptions: () => db.prescriptions as Prescription[],\n  getPayments: () => db.payments as Payment[],\n  \n  getPatientById: (id: string) => db.users.find(u => u.id === id) as User,\n  getEvolutionsByPatient: (patientId: string) => db.evolutions.filter(e => e.patientId === patientId) as EvolutionNote[],\n  getAppointmentsByPatient: (patientId: string) => db.appointments.filter(a => a.patientId === patientId) as Appointment[],\n  getAppointmentsByDoctor: (doctorId: string) => db.appointments.filter(a => a.doctorId === doctorId) as Appointment[],\n  getPrescriptionsByPatient: (patientId: string) => db.prescriptions.filter(p => p.patientId === patientId) as Prescription[],\n  \n  addEvolution: (evo: Partial<EvolutionNote>) => {\n    const newEvo = { ...evo, id: `e${db.evolutions.length + 1}`, date: new Date().toISOString() } as EvolutionNote;\n    db.evolutions.push(newEvo);\n    return newEvo;\n  }\n};\n","path":"/Users/macbook2019/web_doctora_final/website/src/lib/store/mockDb.ts"}}],"stopReason":"toolUse","api":"ollama","provider":"ollama","model":"gemma4:31b-cloud","usage":{"input":53809,"output":1600,"cacheRead":0,"cacheWrite":0,"totalTokens":55409,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"timestamp":1781048391524}}
{"type":"message","id":"920c1426","parentId":"36b7315b","timestamp":"2026-06-09T23:39:51.580Z","message":{"role":"toolResult","toolCallId":"call_puvsodur","toolName":"write","content":[{"type":"text","text":"Successfully wrote 4442 bytes to /Users/macbook2019/web_doctora_final/website/src/lib/store/mockDb.ts"}],"isError":false,"timestamp":1781048391571}}
{"type":"message","id":"01c76cef","parentId":"920c1426","timestamp":"2026-06-09T23:40:16.252Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_dqpr9ahg","name":"write","arguments":{"content":"\"use client\";\nimport React, { useState } from 'react';\nimport { mockDb } from '@/lib/store/mockDb';\nimport { EvolutionNote } from '@/types';\nimport { Save, History, User as UserIcon, Pill } from 'lucide-react';\n\nexport default function PatientFile({ params }: { params: { id: string } }) {\n  const patient = mockDb.getPatientById(params.id);\n  const [evolutions, setEvolutions] = useState(mockDb.getEvolutionsByPatient(params.id));\n  const [newNote, setNewNote] = useState({ symptoms: '', diagnosis: '', treatment: '' });\n\n  const handleSaveEvolution = () => {\n    const saved = mockDb.addEvolution({\n      patientId: params.id,\n      doctorId: 'd1', // Simulado\n      ...newNote\n    });\n    setEvolutions([saved, ...evolutions]);\n    setNewNote({ symptoms: '', diagnosis: '', treatment: '' });\n  };\n\n  return (\n    <div className=\"p-6 max-w-6xl mx-auto bg-gray-50 min-h-screen font-sans\">\n      <div className=\"flex items-center justify-between mb-8\">\n        <h1 className=\"text-3xl font-bold text-blue-900\">Ficha Médica de Paciente</h1>\n        <div className=\"flex gap-2\">\n          <span className={`px-3 py-1 rounded-full text-xs font-bold ${patient.profileStatus === 'verified' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>\n            {patient.profileStatus.replace('_', ' ').toUpperCase()}\n          </span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {/* Info Personal */}\n        <div className=\"bg-white p-6 rounded-2xl shadow-sm border border-gray-100\">\n          <div className=\"flex items-center gap-3 mb-4 text-blue-600\">\n            <UserIcon size={20} />\n            <h2 className=\"font-semibold\">Datos Personales</h2>\n          </div>\n          <div className=\"space-y-3 text-sm text-gray-600\">\n            <p><strong>Nombre:</strong> {patient.name}</p>\n            <p><strong>Email:</strong> {patient.email}</p>\n            <p><strong>Tlf:</strong> {patient.phoneNumber}</p>\n            <div className=\"pt-4 border-t\">\n              <p><strong>Sangre:</strong> {patient.personalData?.bloodType || 'No reg.'}</p>\n              <p><strong>Cédula:</strong> {patient.personalData?.idCardNumber || 'No reg.'}</p>\n              <p><strong>Alergias:</strong> {patient.personalData?.allergies.join(', ') || 'Ninguna'}</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Editor de Evolución */}\n        <div className=\"md:col-span-2 bg-white p-6 rounded-2xl shadow-sm border border-gray-100\">\n          <div className=\"flex items-center gap-3 mb-4 text-blue-600\">\n            <Save size={20} />\n            <h2 className=\"font-semibold\">Nueva Nota de Evolución</h2>\n          </div>\n          <div className=\"grid gap-4\">\n            <textarea \n              placeholder=\"Síntomas y motivo de consulta...\" \n              className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\" \n              rows={3}\n              value={newNote.symptoms}\n              onChange={e => setNewNote({...newNote, symptoms: e.target.value})}\n            />\n            <textarea \n              placeholder=\"Diagnóstico médico...\" \n              className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\" \n              rows={2}\n              value={newNote.diagnosis}\n              onChange={e => setNewNote({...newNote, diagnosis: e.target.value})}\n            />\n            <textarea \n              placeholder=\"Tratamiento y recomendaciones...\" \n              className=\"w-full p-3 border rounded-xl text-sm focus:ring-2 ring-blue-200 outline-none\" \n              rows={2}\n              value={newNote.treatment}\n              onChange={e => setNewNote({...newNote, treatment: e.target.value})}\n            />\n            <button \n              onClick={handleSaveEvolution}\n              className=\"bg-blue-600 text-white px-6 py-2 rounded-xl font-medium hover:bg-blue-700 transition-colors\"\n            >\n              Guardar Evolución\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Historial de Evoluciones */}\n      <div className=\"mt-8 bg-white p-6 rounded-2xl shadow-sm border border-gray-100\">\n        <div className=\"flex items-center gap-3 mb-6 text-blue-600\">\n          <History size={20} />\n          <h2 className=\"font-semibold\">Línea de Tiempo de Evolución</h2>\n        </div>\n        <div className=\"space-y-6\">\n          {evolutions.map((evo) => (\n            <div key={evo.id} className=\"flex gap-4 p-4 bg-blue-50 rounded-xl border-l-4 border-blue-500\">\n              <div className=\"text-xs text-gray-500 min-w-[100px]\">\n                {new Date(evo.date).toLocaleDateString()} <br/>\n                {new Date(evo.date).toLocaleTimeString()}\n              </div>\n              <div className=\"flex-1\">\n                <p className=\"text-sm font-bold text-gray-800\">Síntomas: {evo.symptoms}</p>\n                <p className=\"text-sm text-gray-700 mt-1\"><strong>Diagnóstico:</strong> {evo.diagnosis}</p>\n                <p className=\"text-sm text-gray-600 mt-1 italic\"><strong>Tratamiento:</strong> {evo.treatment}</p>\n              </div>\n            </div>\n          ))}\n          {evolutions.length === 0 && <p className=\"text-gray-400 text-center py-4\">No hay evoluciones registradas.</p>}\n        </div>\n      </div>\n    </div>\n  );\n}\n","path":"/Users/macbook2019/web_doctora_final/website/src/app/doctor/patient-file/[id]/page.tsx"}}],"stopReason":"toolUse","api":"ollama","provider":"ollama","model":"gemma4:31b-cloud","usage":{"input":55453,"output":1594,"cacheRead":0,"cacheWrite":0,"totalTokens":57047,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"timestamp":1781048416250}}
