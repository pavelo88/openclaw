{"type":"message","id":"cbbd57ee","parentId":"76f1d35b","timestamp":"2026-06-09T22:10:39.726Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_ogmni8nl","name":"write","arguments":{"content":"import { User, Doctor, Appointment, Prescription, Payment } from '../types';\n\n// SIMULATED DATABASE\nconst db = {\n  users: [\n    { id: 'u1', email: 'admin@clinica.com', name: 'Super Admin', role: 'ADMIN' },\n    { id: 'u2', email: 'paciente1@gmail.com', name: 'Juan Pérez', role: 'USER', phoneNumber: '+593 999 999 999' },\n    { id: 'u3', email: 'paciente2@gmail.com', name: 'María López', role: 'USER', phoneNumber: '+593 988 888 888' },\n  ],\n  doctors: [\n    {\n      id: 'd1',\n      email: 'psico1@clinica.com',\n      name: 'Dra. Ana Psico',\n      role: 'DOCTOR',\n      specialty: 'Psychology',\n      bio: 'Especialista en terapia cognitivo-conductual y ansiedad.',\n      consultationFee: 45,\n      availability: { days: ['Monday', 'Wednesday', 'Friday'], startTime: '08:00', endTime: '14:00' }\n    },\n    {\n      id: 'd2',\n      email: 'psico2@clinica.com',\n      name: 'Dra. Elena Mente',\n      role: 'DOCTOR',\n      specialty: 'Psychology',\n      bio: 'Experta en psicología infantil y juvenil.',\n      consultationFee: 40,\n      availability: { days: ['Tuesday', 'Thursday'], startTime: '15:00', endTime: '20:00' }\n    },\n    {\n      id: 'd3',\n      email: 'gen1@clinica.com',\n      name: 'Dra. Clara Salud',\n      role: 'DOCTOR',\n      specialty: 'General',\n      bio: 'Medicina general con enfoque preventivo.',\n      consultationFee: 30,\n      availability: { days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], startTime: '09:00', endTime: '17:00' }\n    },\n    {\n      id: 'd4',\n      email: 'gen2@clinica.com',\n      name: 'Dr. Roberto Cura',\n      role: 'DOCTOR',\n      specialty: 'General',\n      bio: 'Especialista en medicina interna y control de diabetes.',\n      consultationFee: 30,\n      availability: { days: ['Monday', 'Wednesday', 'Friday'], startTime: '13:00', endTime: '21:00' }\n    },\n  ],\n  appointments: [\n    { id: 'a1', patientId: 'u2', doctorId: 'd1', date: '2026-06-15', time: '10:00', status: 'scheduled', paymentStatus: 'paid' },\n    { id: 'a2', patientId: 'u3', doctorId: 'd3', date: '2026-06-12', time: '16:30', status: 'completed', paymentStatus: 'paid' },\n  ],\n  prescriptions: [\n    {\n      id: 'p1',\n      appointmentId: 'a2',\n      patientId: 'u3',\n      doctorId: 'd3',\n      medications: [\n        { name: 'Amoxicilina', dosage: '500mg', frequency: 'cada 8 horas', startTime: '08:00', duration: '7 días' }\n      ],\n      createdAt: '2026-06-12'\n    }\n  ],\n  payments: [\n    { id: 'pay1', appointmentId: 'a1', amount: 45, status: 'completed', method: 'card', createdAt: '2026-06-10' },\n    { id: 'pay2', appointmentId: 'a2', amount: 30, status: 'completed', method: 'transfer', createdAt: '2026-06-12' },\n  ]\n};\n\nexport const mockDb = {\n  getUsers: () => db.users as User[],\n  getDoctors: () => db.doctors as Doctor[],\n  getAppointments: () => db.appointments as Appointment[],\n  getPrescriptions: () => db.prescriptions as Prescription[],\n  getPayments: () => db.payments as Payment[],\n  \n  getAppointmentsByPatient: (patientId: string) => db.appointments.filter(a => a.patientId === patientId) as Appointment[],\n  getAppointmentsByDoctor: (doctorId: string) => db.appointments.filter(a => a.doctorId === doctorId) as Appointment[],\n  getPrescriptionsByPatient: (patientId: string) => db.prescriptions.filter(p => p.patientId === patientId) as Prescription[],\n};\n","path":"/Users/macbook2019/web_doctora_final/website/src/lib/store/mockDb.ts"}}],"stopReason":"toolUse","api":"ollama","provider":"ollama","model":"gemma4:31b-cloud","usage":{"input":49846,"output":1212,"cacheRead":0,"cacheWrite":0,"totalTokens":51058,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"timestamp":1781043039724}}
