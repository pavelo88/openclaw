{"type":"message","id":"00c6dd80","parentId":"59e22314","timestamp":"2026-06-09T22:10:08.950Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_dqhndc4o","name":"write","arguments":{"content":"export type Role = 'ADMIN' | 'DOCTOR' | 'USER';\n\nexport interface User {\n  id: string;\n  email: string;\n  name: string;\n  role: Role;\n  avatar?: string;\n  phoneNumber?: string;\n}\n\nexport interface Doctor extends User {\n  specialty: 'General' | 'Psychology' | 'Pediatrics' | 'Neurology';\n  bio: string;\n  consultationFee: number;\n  availability: {\n    days: string[];\n    startTime: string;\n    endTime: string;\n  };\n}\n\nexport interface Appointment {\n  id: string;\n  patientId: string;\n  doctorId: string;\n  date: string;\n  time: string;\n  status: 'scheduled' | 'completed' | 'cancelled' | 'paid';\n  paymentStatus: 'pending' | 'paid';\n  notes?: string;\n}\n\nexport interface Prescription {\n  id: string;\n  appointmentId: string;\n  patientId: string;\n  doctorId: string;\n  medications: {\n    name: string;\n    dosage: string;\n    frequency: string; // e.g., \"every 8 hours\"\n    startTime: string;\n    duration: string;\n  }[];\n  createdAt: string;\n}\n\nexport interface Payment {\n  id: string;\n  appointmentId: string;\n  amount: number;\n  status: 'pending' | 'completed';\n  method: 'card' | 'transfer' | 'cash';\n  createdAt: string;\n}\n","path":"/Users/macbook2019/web_doctora_final/website/src/types/index.ts"}}],"stopReason":"toolUse","api":"ollama","provider":"ollama","model":"gemma4:31b-cloud","usage":{"input":49403,"output":402,"cacheRead":0,"cacheWrite":0,"totalTokens":49805,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"timestamp":1781043008948}}
